<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>PlayableVehicles</AssemblyName>
    <RootNamespace>PlayableVehicles</RootNamespace>
    <Version>1.0.2</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <!-- Релизный DLL: без отладочной информации - иначе в DLL остаётся путь к .pdb в папке проекта на диске
       сборщика. Пути исходников - относительные (сообщения компилятора, CallerFilePath) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
  </PropertyGroup>

  <!-- Путь к игре (по порядку): dotnet build -p:GameDir="...", локальный GameDir.props (не в git:
       <Project><PropertyGroup><GameDir>...</GameDir></PropertyGroup></Project>), переменная окружения
       NUCLEAR_OPTION_DIR, иначе стандартная папка Steam -->
  <Import Project="GameDir.props" Condition="'$(GameDir)' == '' And Exists('GameDir.props')" />
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == '' And '$(NUCLEAR_OPTION_DIR)' != ''">$(NUCLEAR_OPTION_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Nuclear Option</GameDir>
    <ManagedDir>$(GameDir)\NuclearOption_Data\Managed</ManagedDir>
    <PluginsDir>$(GameDir)\BepInEx\plugins</PluginsDir>
  </PropertyGroup>

  <!-- Исходники мода только в src/. tools/ - отдельные утилиты со своим csproj, docs/ - справочники,
       dist/ - релизный архив и публичная копия (dist/github со своими src/) -->
  <ItemGroup>
    <Compile Remove="tools/**;docs/**;dist/**" />
    <None Remove="tools/**;dist/**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirage">
      <HintPath>$(ManagedDir)\Mirage.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Перегрузки INetworkPlayer.Send используют типы из SocketLayer -->
    <Reference Include="Mirage.SocketLayer">
      <HintPath>$(ManagedDir)\Mirage.SocketLayer.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UniTask: ванильные async-методы (выезд машины из ворот базы техники) -->
    <Reference Include="UniTask">
      <HintPath>$(ManagedDir)\UniTask.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rewired_Core">
      <HintPath>$(ManagedDir)\Rewired_Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- AudioClip: ванильный звук хитмаркера -->
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UI-типы полей FlightHud/CombatHUD (Canvas, Image, RawImage, TextMeshProUGUI) -->
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- После сборки кладём DLL в BepInEx\plugins. Если игра запущена и файл занят - только предупреждение, сборка не падает -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(PluginsDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsDir)" ContinueOnError="WarnAndContinue" />
    <Message Importance="high" Text="PlayableVehicles -> $(PluginsDir)" />
  </Target>

</Project>
